# Copy to .env (never commit .env). All values are read with the CONVERGENT_ prefix.
CONVERGENT_API_TOKEN=change-me-to-a-long-random-string   # required for backend writes; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CONVERGENT_DEVICE_TOKEN=change-me-too                     # shared with the Pi agent (video gateway hello)
CONVERGENT_DATABASE_URL=sqlite:///./convergent_dev.db     # or postgresql+psycopg://convergent:convergent@localhost:5432/convergent
CONVERGENT_API_HOST=127.0.0.1                             # bind to a LAN address only when the token is set
CONVERGENT_API_PORT=8000
CONVERGENT_LOG_LEVEL=INFO
CONVERGENT_LOG_DIR=logs
CONVERGENT_ALLOW_UNAUTHENTICATED_READS=true
CONVERGENT_RETAIN_RAW_VIDEO=false
